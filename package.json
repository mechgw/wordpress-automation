{
  "name": "wordpress-automation",
  "version": "0.0.0-unversioned",
  "description": "Google Apps Script automation for WordPress, Google Search Console and GA4",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/*.gs --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout \"test/**/*.test.js\"",
    "quality:gate": "node scripts/quality/coverage-gate.js",
    "quality:debt": "node scripts/quality/debt-ratchet.js",
    "prepare": "node scripts/quality/install-hooks.js",
    "mutation:prepare": "node scripts/mutation/prepare-shadow.js",
    "mutation": "stryker run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CityCouriers/wordpress-automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CityCouriers/wordpress-automation/issues"
  },
  "homepage": "https://github.com/CityCouriers/wordpress-automation#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/clasp": "^3.4.1",
    "@stryker-mutator/core": "^10.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-googleappsscript": "^1.0.5",
    "espree": "^11.2.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
